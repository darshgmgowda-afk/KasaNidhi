MONGO_URI=
MONGO_DB=kasanidhi
# Optional: without Groq, Swatva Sakhi uses deterministic safe guidance fallback and Swatva Mitra voice is disabled.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
GROQ_STT_MODEL=whisper-large-v3-turbo
GROQ_TTS_MODEL=canopylabs/orpheus-v1-english
GROQ_TTS_VOICE=hannah
SCAN_SERVICE_URL=http://localhost:8000
PORT=3000
